# Local development values only. Copy to .env (git-ignored). Never commit real secrets.
# Passwords must match docker-compose.yml (or the overrides you set for it).

# API, worker: app_user (not the table owner, no BYPASSRLS).
DATABASE_URL=postgresql://app_user:app_user_dev_only@localhost:15432/aberdare

# Prisma migrations only: migrator (owns the schema). Never used by the API.
MIGRATION_DATABASE_URL=postgresql://migrator:migrator_dev_only@localhost:15432/aberdare
SHADOW_DATABASE_URL=postgresql://migrator:migrator_dev_only@localhost:15432/aberdare_shadow

# Worker only (Phase F1): pg-boss connects as queue_user, which can reach only the pgboss
# schema. Create pg-boss's tables with `pnpm queue:migrate` after every prisma migrate deploy.
QUEUE_DATABASE_URL=postgresql://queue_user:queue_user_dev_only@localhost:15432/aberdare

# Automated tests: a separate database so tests never touch development data.
TEST_DATABASE_URL=postgresql://app_user:app_user_dev_only@localhost:15432/aberdare_test
TEST_MIGRATION_DATABASE_URL=postgresql://migrator:migrator_dev_only@localhost:15432/aberdare_test
TEST_QUEUE_DATABASE_URL=postgresql://queue_user:queue_user_dev_only@localhost:15432/aberdare_test
# Tests only: the postgres superuser, used solely to seed rows that no app role may
# write yet (for example a person with a password before A2). Never used by the app.
TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres_dev_only@localhost:15432/aberdare_test

# Optional database pool tuning (defaults shown). Production values are an open item.
# DATABASE_POOL_MAX=10
# DATABASE_TX_MAX_WAIT_MS=2000

# Phase A secrets. Required, at least 32 characters each. Fake values: replace for any shared environment.
AUTH_PEPPER=dev-only-pepper-0123456789abcdefghijklmnop
JWT_SECRET=dev-only-jwt-secret-0123456789abcdefghijk
# development | test | production
APP_ENV=development
# Development only: every code is 123456 for the targets listed (refused in production).
AUTH_DEV_FIXED_CODES=false
AUTH_DEV_CODE_ALLOWLIST=
# Requests per minute per IP on each public auth route.
AUTH_RATE_LIMIT_MAX=10

PORT=3000
LOG_LEVEL=info

# HTTP settings, checked at startup (src/config/app.config.ts). Lists are comma-separated
# IP addresses or CIDR ranges.
# Proxies whose X-Forwarded-For is believed. Empty = trust nobody (correct locally).
# In production: the load balancer's private range, once hosting is chosen.
TRUST_PROXY=
# Webhook sources. Mode "log" lets everyone through and logs outsiders; "enforce" blocks them.
WEBHOOK_IP_ALLOWLIST=
WEBHOOK_IP_ALLOWLIST_MODE=log
# Requests per client IP per window (kept in process memory).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
