// Every tenant table also needs a hand-written RLS migration
// (see docs/architecture.md section 3 and CLAUDE.md section 5).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The tenant itself. RLS on its own id from Phase A1 (docs/phase-a-design.md section 4).
model Business {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  type              BusinessType
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products          Product[]
  locations         Location[]
  packTypes         PackType[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  stockConversions  StockConversion[]
  syncCommands      SyncCommand[]
  changes           ChangeLog[]
  memberships       Membership[]
  devices           Device[]
  deviceMemberships DeviceMembership[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  productBarcodes   ProductBarcode[]

  @@map("business")
}

// Tenant table: RLS enabled and forced in 20261024_step1_product_rls.
model Product {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String     @map("business_id") @db.Uuid
  name       String
  // Step 4 ordinary change: optional stock-keeping code. Unique per business
  // when present (Postgres treats NULLs as distinct).
  sku        String?
  // Phase B: archived, never deleted. NULL means active.
  archivedAt DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business   Business   @relation(fields: [businessId], references: [id])
  packTypes  PackType[]
  barcodes   ProductBarcode[]

  // Target for composite foreign keys, so references cannot cross businesses.
  @@unique([businessId, id])
  @@unique([businessId, sku])
  // Keyset paging on (name, id) for GET /v1/products (Phase B).
  @@index([businessId, name, id])
  // Created by the hand-written migration *_step4_product_name_trigram. Declared
  // here only so Prisma knows it exists and does not generate a DROP for it.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_name_trgm_idx")
  @@index([businessId])
  @@map("product")
}

// A shop or warehouse of a business.
model Location {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  name       String
  // Phase B: one default per business ("Main shop", created at signup),
  // enforced by the hand-written partial unique index
  // location_one_default_per_business.
  isDefault  Boolean        @default(false) @map("is_default")
  archivedAt DateTime?      @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business   Business       @relation(fields: [businessId], references: [id])
  balances   StockBalance[]
  movements  StockMovement[]

  @@unique([businessId, id])
  @@map("location")
}

// A way a product is stocked and sold: piece, carton of 24, and so on.
// Each pack type has its own stock pool (docs/architecture.md section 6).
model PackType {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String          @map("business_id") @db.Uuid
  productId    String          @map("product_id") @db.Uuid
  name         String
  // Pieces in one of this pack. 1 for a piece, 24 for a carton of 24.
  unitsPerPack Int             @map("units_per_pack")
  // Phase B: KES, NUMERIC(14,2), never negative (checks in *_b1_catalogue_checks).
  sellPrice    Decimal         @map("sell_price") @db.Decimal(14, 2)
  // Read and written only with costs.view.
  costPrice    Decimal?        @map("cost_price") @db.Decimal(14, 2)
  archivedAt   DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business     Business        @relation(fields: [businessId], references: [id])
  product      Product         @relation(fields: [businessId, productId], references: [businessId, id])
  balances     StockBalance[]
  movements    StockMovement[]
  barcodes     ProductBarcode[]

  @@unique([businessId, id])
  // Target of product_barcode's key, so a barcode cannot point at another
  // product's pack type.
  @@unique([businessId, productId, id])
  @@unique([businessId, productId, unitsPerPack])
  @@unique([businessId, productId, name])
  @@index([businessId, productId])
  @@map("pack_type")
}

// Cached current quantity per location and pack type. Updated in the same
// transaction as every stock_movement insert. May go negative (sale mode).
model StockBalance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  packTypeId String   @map("pack_type_id") @db.Uuid
  quantity   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business   Business @relation(fields: [businessId], references: [id])
  location   Location @relation(fields: [businessId, locationId], references: [businessId, id])
  packType   PackType @relation(fields: [businessId, packTypeId], references: [businessId, id])

  @@unique([businessId, locationId, packTypeId])
  @@map("stock_balance")
}

// Append-only ledger. Never updated or deleted (app_user has no UPDATE or
// DELETE grant). Corrections are new rows. No updated_at for that reason.
model StockMovement {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String           @map("business_id") @db.Uuid
  locationId     String           @map("location_id") @db.Uuid
  packTypeId     String           @map("pack_type_id") @db.Uuid
  quantityChange Int              @map("quantity_change")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  business       Business         @relation(fields: [businessId], references: [id])
  location       Location         @relation(fields: [businessId, locationId], references: [businessId, id])
  packType       PackType         @relation(fields: [businessId, packTypeId], references: [businessId, id])
  conversionOut  StockConversion? @relation("ConversionOut")
  conversionIn   StockConversion? @relation("ConversionIn")

  @@unique([businessId, id])
  @@index([businessId, locationId, packTypeId])
  @@map("stock_movement")
}

// Links the two movements of one break-bulk (minus 1 carton, plus N pieces).
model StockConversion {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String        @map("business_id") @db.Uuid
  outMovementId String        @map("out_movement_id") @db.Uuid
  inMovementId  String        @map("in_movement_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  business      Business      @relation(fields: [businessId], references: [id])
  outMovement   StockMovement @relation("ConversionOut", fields: [businessId, outMovementId], references: [businessId, id])
  inMovement    StockMovement @relation("ConversionIn", fields: [businessId, inMovementId], references: [businessId, id])

  // Each movement belongs to at most one conversion.
  @@unique([businessId, outMovementId])
  @@unique([businessId, inMovementId])
  @@map("stock_conversion")
}

// Outcome of a phone command (docs/architecture.md section 5).
// PROCESSING is only ever visible inside the transaction handling the command;
// every committed row is ACCEPTED, FLAGGED or REJECTED.
enum SyncCommandStatus {
  PROCESSING
  ACCEPTED
  FLAGGED
  REJECTED

  @@map("sync_command_status")
}

// One row per command a phone sent. The unique (business_id, command_id)
// constraint is what makes processing idempotent. Immutable once committed.
model SyncCommand {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String            @map("business_id") @db.Uuid
  // UUID generated by the phone for this command.
  commandId  String            @map("command_id") @db.Uuid
  type       String
  status     SyncCommandStatus
  // What every caller gets back for this command. NULL only while PROCESSING.
  result     Json?
  // Phase B: when the phone says it happened, and when the server got it
  // (from the Clock). Cannot be backfilled, so stored from the start.
  occurredAt DateTime          @map("occurred_at") @db.Timestamptz(6)
  receivedAt DateTime          @map("received_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  business   Business          @relation(fields: [businessId], references: [id])

  @@unique([businessId, commandId])
  @@map("sync_command")
}

// What changed, for GET /v1/sync/changes?cursor= (docs/architecture.md
// section 5). Written only by triggers, never by application code.
// id is a growing number (not a UUID) because it is the sync cursor.
model ChangeLog {
  id         BigInt   @id @default(autoincrement())
  businessId String   @map("business_id") @db.Uuid
  tableName  String   @map("table_name")
  rowId      String   @map("row_id") @db.Uuid
  // INSERT, UPDATE or DELETE (the trigger's TG_OP).
  operation  String
  // Phase B: the row's natural key where phones identify rows by it rather
  // than by id. Only product_barcode sets it (the barcode text), so a phone
  // can remove a barcode it only knows by its code. NULL for other tables.
  rowKey     String?  @map("row_key")
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId, id])
  @@map("change_log")
}

// Phase B: barcode (text, never a number) to one product and pack type,
// unique per business (docs/phase-b-design.md section 3). The only catalogue
// table where rows are deleted (barcode.remove); the change_log trigger
// records the delete. Inserted and deleted, never updated, so no updated_at.
model ProductBarcode {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId            String     @map("business_id") @db.Uuid
  // Normalised before storing; format checked by product_barcode_format.
  barcode               String
  productId             String     @map("product_id") @db.Uuid
  packTypeId            String     @map("pack_type_id") @db.Uuid
  createdByMembershipId String     @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  business              Business   @relation(fields: [businessId], references: [id])
  product               Product    @relation(fields: [businessId, productId], references: [businessId, id])
  // Includes product_id, so the pack type must belong to this very product.
  packType              PackType   @relation(fields: [businessId, productId, packTypeId], references: [businessId, productId, id])
  createdBy             Membership @relation(fields: [businessId, createdByMembershipId], references: [businessId, id])

  @@unique([businessId, id])
  @@unique([businessId, barcode])
  @@map("product_barcode")
}

// ---------------------------------------------------------------------------
// Phase A: identity (docs/phase-a-design.md section 4). Columns exactly as
// designed. Hand-written SQL adds RLS, grants, checks, the one-owner index and
// the identity functions (section 5).
// ---------------------------------------------------------------------------

enum RolePreset {
  OWNER
  MANAGER
  ATTENDANT

  @@map("role_preset")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED

  @@map("membership_status")
}

enum DeviceStatus {
  ACTIVE
  REVOKED

  @@map("device_status")
}

// One human across the whole system. Not tenant-owned: app_user reads it only
// for people with a membership in the current business, never the password or
// lock columns, and never writes it. Writes go through the identity functions.
model Person {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // E.164, for example +254712345678.
  phone             String       @unique
  phoneVerifiedAt   DateTime?    @map("phone_verified_at") @db.Timestamptz(6)
  // Stored lowercase. Owners only.
  email             String?      @unique
  emailVerifiedAt   DateTime?    @map("email_verified_at") @db.Timestamptz(6)
  // scrypt, self-describing format. Owners only.
  passwordHash      String?      @map("password_hash")
  passwordChangedAt DateTime?    @map("password_changed_at") @db.Timestamptz(6)
  failedLoginCount  Int          @default(0) @map("failed_login_count")
  loginLockedUntil  DateTime?    @map("login_locked_until") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships       Membership[]

  @@map("person")
}

// A person's role inside one business. Tenant table.
model Membership {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId            String            @map("business_id") @db.Uuid
  personId              String            @map("person_id") @db.Uuid
  // Shown on the "Who is selling?" screen.
  displayName           String            @map("display_name")
  rolePreset            RolePreset        @map("role_preset")
  extraPermissions      String[]          @default([]) @map("extra_permissions")
  status                MembershipStatus
  pinHash               String?           @map("pin_hash")
  pinSetAt              DateTime?         @map("pin_set_at") @db.Timestamptz(6)
  pinFailedCount        Int               @default(0) @map("pin_failed_count")
  pinLockedUntil        DateTime?         @map("pin_locked_until") @db.Timestamptz(6)
  tempPinHash           String?           @map("temp_pin_hash")
  tempPinExpiresAt      DateTime?         @map("temp_pin_expires_at") @db.Timestamptz(6)
  tempPinFailedCount    Int               @default(0) @map("temp_pin_failed_count")
  // NULL for the owner membership created at signup.
  createdByMembershipId String?           @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  business              Business          @relation(fields: [businessId], references: [id])
  person                Person            @relation(fields: [personId], references: [id])
  createdBy             Membership?       @relation("MembershipCreatedBy", fields: [businessId, createdByMembershipId], references: [businessId, id])
  created               Membership[]      @relation("MembershipCreatedBy")
  devicesRegistered     Device[]
  deviceLinks           DeviceMembership[]
  refreshTokens         RefreshToken[]
  auditEntries          AuditLog[]
  barcodesCreated       ProductBarcode[]

  @@unique([businessId, id])
  @@unique([businessId, personId])
  @@index([personId])
  @@map("membership")
}

// A registered phone or tablet. Tenant table.
model Device {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId               String             @map("business_id") @db.Uuid
  name                     String
  // As reported by the app, for example "android" or "ios".
  platform                 String
  // SHA-256 of the 32-byte device secret (shown to the app once).
  secretHash               String             @map("secret_hash")
  isShared                 Boolean            @default(false) @map("is_shared")
  status                   DeviceStatus
  registeredByMembershipId String             @map("registered_by_membership_id") @db.Uuid
  // Unused until Phase F.
  pushToken                String?            @map("push_token")
  lastSeenAt               DateTime?          @map("last_seen_at") @db.Timestamptz(6)
  lastSyncAt               DateTime?          @map("last_sync_at") @db.Timestamptz(6)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  business                 Business           @relation(fields: [businessId], references: [id])
  registeredBy             Membership         @relation(fields: [businessId, registeredByMembershipId], references: [businessId, id])
  memberLinks              DeviceMembership[]
  refreshTokens            RefreshToken[]

  @@unique([businessId, id])
  @@map("device")
}

// Which memberships may sell on a shared device. Tenant table.
model DeviceMembership {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String     @map("business_id") @db.Uuid
  deviceId     String     @map("device_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  business     Business   @relation(fields: [businessId], references: [id])
  device       Device     @relation(fields: [businessId, deviceId], references: [businessId, id])
  membership   Membership @relation(fields: [businessId, membershipId], references: [businessId, id])

  @@unique([businessId, deviceId, membershipId])
  @@map("device_membership")
}

// Rotating refresh tokens. Only the SHA-256 hash is stored. Tenant table.
model RefreshToken {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String     @map("business_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  deviceId     String     @map("device_id") @db.Uuid
  // All tokens from one login share a family; reuse revokes the family.
  familyId     String     @map("family_id") @db.Uuid
  tokenHash    String     @unique @map("token_hash")
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime?  @map("used_at") @db.Timestamptz(6)
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  business     Business   @relation(fields: [businessId], references: [id])
  membership   Membership @relation(fields: [businessId, membershipId], references: [businessId, id])
  device       Device     @relation(fields: [businessId, deviceId], references: [businessId, id])

  @@index([businessId, familyId])
  @@map("refresh_token")
}

enum BusinessType {
  RETAIL
  WHOLESALE
  WAREHOUSE

  @@map("business_type")
}

enum OtpChannel {
  SMS
  EMAIL

  @@map("otp_channel")
}

enum OtpPurpose {
  SIGNUP
  STAFF_ACTIVATE
  PASSWORD_RESET

  @@map("otp_purpose")
}

// SMS and email codes (docs/phase-a-design.md section 4). Not tenant-owned and
// holds nothing tenant-related. app_user has no privileges on it: it is reached
// only through the identity functions, like person.
model OtpChallenge {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel    OtpChannel
  // E.164 phone for SMS, lowercase email for EMAIL.
  target     String
  purpose    OtpPurpose
  // HMAC-SHA256 of the code with the server pepper. Never the code itself.
  codeHash   String     @map("code_hash")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  attempts   Int        @default(0)
  verifiedAt DateTime?  @map("verified_at") @db.Timestamptz(6)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  // Send limits and "latest live challenge" lookups.
  @@index([target, purpose, createdAt])
  @@map("otp_challenge")
}

// Who did what, when (docs/phase-a-design.md sections 4 and 14). Tenant
// table, append-only: app_user may SELECT and INSERT only. Written by
// AuditService in the same transaction as the change it records. Metadata
// never holds secrets.
model AuditLog {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String      @map("business_id") @db.Uuid
  // NULL for system events (PIN lockout, refresh token reuse, password reset).
  actorMembershipId String?     @map("actor_membership_id") @db.Uuid
  // For example "staff.suspended".
  action            String
  targetType        String      @map("target_type")
  targetId          String?     @map("target_id") @db.Uuid
  metadata          Json        @default("{}")
  ip                String?     @db.Inet
  // From the Clock.
  occurredAt        DateTime    @map("occurred_at") @db.Timestamptz(6)
  business          Business    @relation(fields: [businessId], references: [id])
  actor             Membership? @relation(fields: [businessId, actorMembershipId], references: [businessId, id])

  @@index([businessId, occurredAt])
  @@map("audit_log")
}
